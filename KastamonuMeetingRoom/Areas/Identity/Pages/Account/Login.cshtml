@page
@model LoginModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Giriş Yap";
}

<h1 class="text-center">Giriş Yap</h1>
<h4 class="text-center">Hesabınıza giriş yapın</h4>
<hr />

<div class="row justify-content-center">
    <div class="col-md-4">

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mt-3">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <!-- Google reCAPTCHA -->
            <script src="https://www.google.com/recaptcha/api.js" async defer></script>

            <div class="g-recaptcha mt-3"
                 data-sitekey="@Configuration["GoogleReCaptcha:SiteKey"]">
            </div>

            <!-- Manuel CAPTCHA -->
            <div class="mt-3 p-2 bg-light border rounded">
                <label><strong>Güvenlik Kodu:</strong></label>

                <div class="mb-2"
                     style="font-size:22px; font-weight:bold; letter-spacing:3px;">
                    @HttpContext.Session.GetString("CaptchaCode")
                </div>

                <input type="text" name="manual-captcha"
                       class="form-control" placeholder="Kodu yazın" required />
            </div>

            <button class="btn btn-primary w-100 mt-3" type="submit">
                Giriş Yap
            </button>

            <div class="text-center mt-3">
                <a asp-page="./Register">Hesabın yok mu? Kayıt Ol</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}

