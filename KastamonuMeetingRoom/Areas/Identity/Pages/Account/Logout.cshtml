@page
@model LogoutModel
@{
    ViewData["Title"] = "Çıkış Yapıldı";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:60vh;">
    <div class="card shadow p-5 text-center" style="max-width:420px;">

        <i class="bi bi-check-circle-fill text-success display-4 mb-3"></i>

        <h3 class="fw-bold mb-2">Çıkış Yapıldı</h3>
        <p class="text-muted mb-4">
            Hesabınızdan güvenli bir şekilde çıkış yaptınız.
        </p>

        <!-- 🔥 ANASAYFAYA DÖN -->
        <a asp-area=""
           asp-controller="Home"
           asp-action="Index"
           class="btn btn-danger rounded-pill px-4 fw-semibold">
            Anasayfaya Dön
        </a>
    </div>
</div>
