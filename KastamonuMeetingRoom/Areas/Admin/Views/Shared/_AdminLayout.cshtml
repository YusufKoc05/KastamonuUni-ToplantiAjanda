@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Kastamonu Üniversitesi Yönetim Paneli</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            background: #f8fafc;
            font-family: Poppins, sans-serif;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            background: linear-gradient(180deg, #111111 0%, #1a1a1a 60%, #8e1c1c 100%);
            padding-top: 25px;
            border-right: 3px solid #b22525;
            z-index: 1000;
        }

        .sidebar a {
            color: #e4e4e7;
            padding: 14px 22px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            transition: all 0.2s ease;
            font-size: 0.95rem;
        }

        .sidebar a:hover {
            background: rgba(178, 37, 37, 0.35);
            color: #ffffff;
        }

        .sidebar a.active {
            background: #b22525;
            color: #ffffff;
            font-weight: 600;
        }

        .content {
            margin-left: 270px;
            padding: 30px;
        }
    </style>
</head>

<body>

    <div class="sidebar d-flex flex-column">
        <div class="text-center mb-4 px-3">
            <img src="~/images/LOGO.png" alt="KÜ" style="height: 48px; width: auto; margin-bottom: 8px;" />
            <h5 class="text-white fw-bold mb-0">Kastamonu Üni.</h5>
            <small class="text-danger fw-semibold">YÖNETİM PANELİ</small>
        </div>

        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="@(currentController=="Dashboard"?"active":"")">
            <i class="bi bi-speedometer2"></i> Dashboard & Özet
        </a>

        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
           class="@(currentController=="Users"?"active":"")">
            <i class="bi bi-people"></i> Kullanıcı Yönetimi
        </a>

        <a asp-area="Admin" asp-controller="Rooms" asp-action="Index"
           class="@(currentController=="Rooms"?"active":"")">
            <i class="bi bi-door-open"></i> Salon Yönetimi
        </a>

        <a asp-area="Admin" asp-controller="Reservation" asp-action="Index"
           class="@(currentController=="Reservation"?"active":"")">
            <i class="bi bi-calendar-check"></i> Tüm Rezervasyonlar
        </a>

        <hr class="border-secondary mx-3 my-3">

        <a class="nav-link text-white"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">
            <i class="bi bi-arrow-left-circle text-danger"></i> Siteye Dön
        </a>

        <div class="mt-auto p-3">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light btn-sm w-100 rounded-pill">
                    <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap
                </button>
            </form>
        </div>
    </div>

    <div class="content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
