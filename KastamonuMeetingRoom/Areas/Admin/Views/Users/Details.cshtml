@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin";
}
@model KastamonuMeetingRoom.Models.ApplicationUser

@{
    ViewData["Title"] = "Kullanıcı Detayı";
    var roles = ViewBag.Roles as IList<string>;
    var reservations = ViewBag.Reservations as List<KastamonuMeetingRoom.Models.Reservation>;
}

<h2 class="fw-bold mb-4">
    <i class="bi bi-person-circle"></i> Kullanıcı Detayı
</h2>

<div class="card shadow-sm p-4 mb-4">

    <h4>@Model.FullName</h4>
    <p><strong>Email:</strong> @Model.Email</p>

    <p>
        <strong>Roller:</strong>
        @foreach (var role in roles)
        {
                <span class="badge bg-primary">@role</span>
        }
    </p>

</div>

<!-- Rezervasyonlar -->
<h4 class="mt-4 mb-3">📅 Kullanıcının Rezervasyonları</h4>

@if (reservations.Count == 0)
{
        <p class="text-muted">Bu kullanıcıya ait rezervasyon bulunmuyor.</p>
}
else
{
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Oda</th>
                    <th>Başlık</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in reservations)
            {
                        <tr class="@(r.IsCancelled ? "text-muted" : "")">
                            <td>@r.Room.Name</td>
                            <td>@r.Title</td>
                            <td>@r.StartTime</td>
                            <td>@r.EndTime</td>
                            <td>
                        @if (r.IsCancelled)
                        {
                                        <span class="badge bg-secondary">İptal Edildi</span>
                        }
                        else
                        {
                                        <span class="badge bg-success">Aktif</span>
                        }
                            </td>
                        </tr>
            }
            </tbody>
        </table>
}

