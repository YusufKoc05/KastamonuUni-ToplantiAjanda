@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin";
}
@model KastamonuMeetingRoom.Models.ApplicationUser

@{
    ViewData["Title"] = "Rol Ata";
}

<h2 class="fw-bold mb-3">🔐 Rol Güncelleme</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-bold">Kullanıcı</label>
        <input class="form-control" value="@Model.FullName (@Model.Email)" disabled />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Yeni Rol Seç</label>
        <select name="roleName" class="form-select">
            @foreach (var role in ViewBag.Roles)
            {
                    <option value="@role.Name">@role.Name</option>
            }
        </select>
    </div>

    <button class="btn btn-primary">
        <i class="bi bi-check-circle"></i> Kaydet
    </button>

    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary ms-2">
        İptal
    </a>
</form>

