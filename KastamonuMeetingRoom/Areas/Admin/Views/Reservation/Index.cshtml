@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin";
}@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Rezervasyon Yönetimi";
}

@model List<KastamonuMeetingRoom.Models.Reservation>

<h2 class="fw-bold mb-4">📅 Rezervasyon Yönetimi</h2>

<table class="table table-striped table-bordered">
    <thead class="table-primary">
        <tr>
            <th>Oda</th>
            <th>Başlık</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Kullanıcı</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var r in Model)
        {
            <tr class="@(r.IsCancelled ? "table-secondary" : "")">
                <td>@r.Room.Name</td>
                <td>@r.Title</td>
                <td>@r.StartTime</td>
                <td>@r.EndTime</td>
                <td>@r.User.FullName</td>

                <td>
                    @if (r.IsCancelled)
                    {
                        <span class="badge bg-secondary">İptal Edildi</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                </td>

                <td class="d-flex gap-2">

                    <!-- DETAY → SİYAH -->
                    <a asp-area="Admin"
                       asp-controller="Reservation"
                       asp-action="Details"
                       asp-route-id="@r.ReservationId"
                       class="btn btn-dark btn-sm text-white">
                        Detay
                    </a>

                    <!-- İPTAL → GRİ -->
                    <form asp-area="Admin"
                          asp-controller="Reservation"
                          asp-action="Cancel"
                          method="post">
                        <input type="hidden" name="id" value="@r.ReservationId" />
                        @Html.AntiForgeryToken()
                        <button class="btn btn-secondary btn-sm text-white">
                            İptal
                        </button>
                    </form>

                    <!-- SİL → KIRMIZI -->
                    <form asp-area="Admin"
                          asp-controller="Reservation"
                          asp-action="Delete"
                          method="post">
                        <input type="hidden" name="id" value="@r.ReservationId" />
                        @Html.AntiForgeryToken()
                        <button class="btn btn-danger btn-sm">
                            Sil
                        </button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>

