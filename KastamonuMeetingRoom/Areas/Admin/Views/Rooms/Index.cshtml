@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin";
}
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Yönetim Paneli";
}
@model List<KastamonuMeetingRoom.Models.Room>


<h2 class="fw-bold mb-3">Oda Yönetimi</h2>

<a class="btn btn-primary mb-3" asp-action="Create">Yeni Oda Ekle</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Oda Adı</th>
            <th>Kapasite</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var room in Model)
        {
                <tr>
                    <td>@room.Name</td>
                    <td>@room.Capacity Kişi</td>
                    <td>
                    <a asp-action="Edit"
                       asp-route-id="@room.RoomId"
                       class="btn btn-secondary btn-sm">
                        Düzenle
                    </a>

                        <a asp-action="Delete" asp-route-id="@room.RoomId" class="btn btn-danger btn-sm">Sil</a>
                    </td>
                </tr>
        }
    </tbody>
</table>


