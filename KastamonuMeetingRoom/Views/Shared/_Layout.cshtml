<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kastamonu Üniversitesi Toplantı & Ajanda Sistemi</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body style="font-family:'Poppins', sans-serif; display:flex; flex-direction:column; min-height:100vh;">

    <!-- 🌟 KASTAMONU ÜNİVERSİTESİ KIRMIZI-BEYAZ-SİYAH NAVBAR -->
    <header class="d-print-none">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-ku py-2">
            <div class="container-fluid px-lg-4">

                <!-- KURUMSAL LOGO & BAŞLIK -->
                <a class="navbar-brand fw-bold text-white d-flex align-items-center me-4"
                   asp-controller="Home" asp-action="Index">
                    <img src="~/images/LOGO.png"
                         alt="Kastamonu Üniversitesi"
                         style="height:44px; width:auto; margin-right:12px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));" />
                    <div>
                        <div class="fs-6 fw-bold lh-1 text-white">KASTAMONU ÜNİVERSİTESİ</div>
                        <div class="fw-normal text-white-50" style="font-size: 0.72rem; letter-spacing: 0.5px;">TOPLANTI VE AJANDA SİSTEMİ</div>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Menüyü Aç/Kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- SOL MENÜ: HERKES İÇİN ERİŞİLEBİLİR ÖĞELER -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Anasayfa
                            </a>
                        </li>

                        <!-- 📅 AJANDA & TAKVİM -->
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-white" asp-controller="Reservation" asp-action="Calendar">
                                <i class="bi bi-calendar3 me-1 text-danger"></i> Ajanda & Takvim
                            </a>
                        </li>

                        <!-- 🏛️ SALONLAR -->
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-white" asp-controller="Room" asp-action="Index">
                                <i class="bi bi-door-open me-1 text-danger"></i> Toplantı Salonları
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded-pill text-white" asp-controller="Reservation" asp-action="Index">
                                    <i class="bi bi-calendar-check me-1"></i> Rezervasyonlarım
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link px-3 rounded-pill btn-ku-red text-white fw-semibold" asp-controller="Reservation" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i> Toplantı Planla
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle px-3 rounded-pill text-white bg-white bg-opacity-10" data-bs-toggle="dropdown" href="#" role="button">
                                        <i class="bi bi-shield-lock me-1"></i> Yönetim
                                    </a>
                                    <ul class="dropdown-menu shadow border-0 rounded-3 mt-1">
                                        <li>
                                            <a class="dropdown-item py-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2 text-danger"></i> Yönetici Paneli
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-area="Admin" asp-controller="Rooms" asp-action="Index">
                                                <i class="bi bi-building me-2 text-dark"></i> Salon Yönetimi
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-area="Admin" asp-controller="Users" asp-action="Index">
                                                <i class="bi bi-people me-2 text-secondary"></i> Kullanıcı Yönetimi
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <!-- SAĞ MENÜ: KOYU MOD & KULLANICI İŞLEMLERİ -->
                    <ul class="navbar-nav align-items-center gap-2">
                        <!-- 🌓 KOYU MOD TOGGLE -->
                        <li class="nav-item">
                            <button id="themeToggleBtn" class="btn btn-outline-light btn-sm rounded-circle p-2" title="Koyu/Açık Mod Geçişi" style="width: 36px; height: 36px; display:flex; align-items:center; justify-content:center;">
                                <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                            </button>
                        </li>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <div class="nav-link text-white fw-medium d-flex align-items-center">
                                    <span class="rounded-circle bg-danger text-white d-inline-flex align-items-center justify-content-center me-2 fw-bold" style="width: 30px; height: 30px; font-size: 0.85rem;">
                                        @User.Identity.Name?.Substring(0, 1).ToUpper()
                                    </span>
                                    <span>@User.Identity.Name</span>
                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-area="Identity"
                                      asp-page="/Account/Logout"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm rounded-pill px-3"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-danger btn-sm rounded-pill px-4 fw-bold"
                                   asp-area="Identity"
                                   asp-page="/Account/Register">
                                    <i class="bi bi-person-plus me-1"></i> Kayıt Ol
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- ANA İÇERİK -->
    <div class="container-fluid px-lg-4 my-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- KURUMSAL SİYAH-KIRMIZI FOOTER -->
    <footer class="footer text-white py-4 mt-auto d-print-none" style="background:#111111; border-top: 3px solid #B22525;">
        <div class="container-fluid px-lg-4">
            <div class="row align-items-center text-center text-md-start">
                <div class="col-md-6 mb-3 mb-md-0">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start">
                        <img src="~/images/LOGO.png" alt="KÜ" style="height: 36px; width: auto; margin-right: 12px;" />
                        <div>
                            <div class="fw-bold">Kastamonu Üniversitesi</div>
                            <div class="small text-white-50">Bilgi İşlem Daire Başkanlığı — Toplantı & Ajanda Portalı</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end small text-white-50">
                    <div>© @DateTime.Now.Year Kastamonu Üniversitesi. Tüm Hakları Saklıdır.</div>
                    <div class="mt-1">
                        <span class="badge bg-danger bg-opacity-25 text-white border border-danger border-opacity-50">
                            <i class="bi bi-broadcast me-1"></i> Canlı Senkronizasyon (SignalR) • Outlook • Google • iCal
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/site.js"></script>

    <!-- KOYU MOD VE SİGNALR ENTEGRASYONU -->
    <script>
        // 🌓 KOYU / AÇIK MOD YÖNETİMİ
        (function () {
            var currentTheme = localStorage.getItem('ku_theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', currentTheme);

            function updateThemeIcon(theme) {
                var icon = document.getElementById('themeIcon');
                if (icon) {
                    if (theme === 'dark') {
                        icon.className = 'bi bi-sun-fill text-warning';
                    } else {
                        icon.className = 'bi bi-moon-stars-fill text-white';
                    }
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                updateThemeIcon(currentTheme);

                var toggleBtn = document.getElementById('themeToggleBtn');
                if (toggleBtn) {
                    toggleBtn.addEventListener('click', function () {
                        var activeTheme = document.documentElement.getAttribute('data-bs-theme');
                        var newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                        document.documentElement.setAttribute('data-bs-theme', newTheme);
                        localStorage.setItem('ku_theme', newTheme);
                        updateThemeIcon(newTheme);
                    });
                }
            });
        })();

        // 🔄 SIGNALR CANLI BAĞLANTI (Real-Time Calendar Sync)
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/calendarHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveCalendarUpdate", function (action, reservationId, title) {
            // Eğer takvim sayfası açıksa takvimi yenile
            if (window.calendarRef) {
                window.calendarRef.refetchEvents();
            }

            var message = "Bir toplantı güncellendi: " + (title || "");
            if (action === "created") message = "Yeni toplantı planlandı: " + title;
            if (action === "cancelled") message = "Toplantı iptal edildi: " + title;
            if (action === "deleted") message = "Toplantı silindi: " + title;

            // Toast Bildirimi
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3500,
                timerProgressBar: true
            });
            Toast.fire({
                icon: 'info',
                title: message
            });
        });

        connection.start().catch(function (err) {
            console.warn("SignalR bağlantı uyarısı:", err);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
