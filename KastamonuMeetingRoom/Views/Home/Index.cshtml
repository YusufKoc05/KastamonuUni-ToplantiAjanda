@{
    ViewData["Title"] = "Anasayfa";
}

<div class="container mt-5">

    <!-- HERO -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5 text-dark">
            Kastamonu Üniversitesi<br />
            <span class="text-danger">Toplantı Odası Rezervasyon Sistemi</span>
        </h1>

        <p class="fs-5 mt-4 text-secondary">
            Akademik ve idari personel için özel olarak geliştirilen,
            <strong>planlı, güvenli ve kullanıcı dostu</strong>
            toplantı odası yönetim platformu
        </p>

        <p class="mt-2 text-muted">
            Oda uygunluklarını anında görüntüleyin,
            rezervasyonlarınızı tek merkezden yönetin.
        </p>

       
    </div>

    <!-- ÖZELLİKLER -->
    <div class="row g-4 text-center">

        <div class="col-md-4">
            <div class="card shadow-sm h-100 p-4 border-0">
                <i class="bi bi-calendar-check display-4 text-danger mb-3"></i>
                <h5 class="fw-bold mb-2">Hızlı ve Kolay Rezervasyon</h5>
                <p class="text-muted">
                    Uygun toplantı odalarını anında görüntüleyin,
                    tarih ve saat seçerek saniyeler içinde
                    rezervasyon işleminizi tamamlayın.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 p-4 border-0">
                <i class="bi bi-clock-history display-4 text-danger mb-3"></i>
                <h5 class="fw-bold mb-2">Gelişmiş Takvim Sistemi</h5>
                <p class="text-muted">
                    Günlük, haftalık ve aylık takvim görünümleri ile
                    tüm rezervasyonları çakışmasız ve düzenli şekilde
                    takip edin.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 p-4 border-0">
                <i class="bi bi-shield-lock display-4 text-danger mb-3"></i>
                <h5 class="fw-bold mb-2">Yetkili ve Güvenli Yönetim</h5>
                <p class="text-muted">
                    Yönetici paneli sayesinde oda, kullanıcı ve
                    rezervasyon işlemlerini rol bazlı,
                    güvenli bir altyapı ile yönetin.
                </p>
            </div>
        </div>

    </div>

    <!-- ALT BİLGİ -->
    <div class="text-center mt-5 text-secondary">
        <p class="fs-6">
            Bu sistem,
            <strong>ASP.NET Core MVC</strong>,
            <strong>Entity Framework Core</strong> ve
            <strong>ASP.NET Identity</strong>
            teknolojileri kullanılarak geliştirilmiştir.
        </p>

        <p class="text-muted">
            Modern mimari, yüksek güvenlik ve ölçeklenebilir yapı
            esas alınarak tasarlanmıştır.
        </p>
    </div>

</div>

