@model KastamonuMeetingRoom.Models.Room

<h2 class="fw-bold mb-4">
    <i class="bi bi-plus-circle me-2 text-reserve"></i> Yeni Oda Ekle
</h2>

<form method="post" class="card p-4 shadow-sm rounded-4">

    <div class="mb-3">
        <label class="form-label fw-semibold">Oda Adı</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Kapasite</label>
        <input asp-for="Capacity" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Lokasyon</label>
        <input asp-for="Location" class="form-control" />
    </div>

    <button class="btn btn-reserve mt-3 px-4">
        <i class="bi bi-check2-circle me-1"></i> Kaydet
    </button>

</form>
