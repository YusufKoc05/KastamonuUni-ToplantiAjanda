
@model List<KastamonuMeetingRoom.Models.Room>

<h2 class="mb-4 fw-bold">
    <i class="bi bi-building-check" style="color: var(--primary); margin-right: 8px;"></i>
    Odalar
</h2>

<div class="row g-4">

    @foreach (var room in Model)
    {
            <div class="col-md-4">
                <div class="room-card h-100">

                    <!-- Premium Icon -->
                    <div class="room-icon text-center mb-3">
                        <i class="bi bi-door-open-fill"></i>
                    </div>

                    <!-- Room Info -->
                    <div class="text-center">
                        <h4 class="room-title mb-3">@room.Name</h4>

                        <div class="d-flex justify-content-center align-items-center mb-2">
                            <i class="bi bi-people-fill text-secondary me-2"></i>
                            <span class="fw-semibold">Kapasite: @room.Capacity</span>
                        </div>

                        <div class="d-flex justify-content-center align-items-center mb-3">
                            <i class="bi bi-geo-alt-fill" style="color: var(--accent); margin-right: 6px;"></i>
                            <span class="fw-semibold">Lokasyon: @room.Location</span>
                        </div>
                    </div>

                    <hr />

                    <!-- Buttons -->
                <div class="room-actions px-2">


                    @if (User.IsInRole("Admin"))
                    {
                                <!-- Admin Buttons -->
                                <a href="/Room/Edit/@room.RoomId" class="btn btn-edit rounded-pill btn-sm">
                                    <i class="bi bi-pencil-square me-1"></i> Düzenle
                                </a>

                                <a href="/Room/Delete/@room.RoomId" class="btn btn-outline-danger rounded-pill btn-sm">
                                    <i class="bi bi-trash-fill me-1"></i> Sil
                                </a>
                    }

                        <!-- Kullanıcı + Admin Ortak -->
                    <div class="d-flex justify-content-center mt-3">
                        <a class="btn btn-danger btn-sm" asp-controller="Reservation" asp-action="Create" asp-route-roomId="@room.RoomId">
                            <i class="bi bi-plus-circle"></i> Rezerve Et
                        </a>
                    </div>



                    </div>

                </div>
            </div>
    }

</div>

<!-- Only Admin Can See New Room Button -->
@if (User.IsInRole("Admin"))
{
        <div class="mt-4">
            <a href="/Room/Create" class="btn btn-soft-green rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle me-2" style="color:white;"></i> Yeni Oda Ekle
            </a>
        </div>
}
<style>
    .btn-danger {
        border-radius: 30px;
    }
</style>

