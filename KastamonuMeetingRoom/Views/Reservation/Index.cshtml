@model List<KastamonuMeetingRoom.Models.Reservation>

<h2 class="mb-3 fw-bold">Rezervasyonlar</h2>

<table class="table table-hover table-striped">
    <thead class="table-primary">
        <tr>
            <th>Oda</th>
            <th>Başlık</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Kullanıcı</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            if (item.IsCancelled)
            {
                        <tr class="text-muted">
                            <td>
                                <div class="reservation-room-header">
                                    <s>@item.Room.Name</s>
                                </div>
                            </td>

                            <td><s>@item.Title</s></td>
                            <td><s>@item.StartTime</s></td>
                            <td><s>@item.EndTime</s></td>

                            <td>@item.User?.FullName</td>

                            <td>
                                <span class="badge bg-secondary">❌ İptal Edildi</span>
                            </td>

                            <td>
                        @if (User.IsInRole("Admin"))
                        {
                                        <a href="/Reservation/Delete/@item.ReservationId" class="btn btn-danger btn-sm">
                                            Sil
                                        </a>
                        }
                            </td>
                        </tr>
            }
            else
            {
                        <tr>
                            <td>
                                <div class="reservation-room-header">
                            @item.Room.Name
                                </div>
                            </td>

                            <td>@item.Title</td>
                            <td>@item.StartTime</td>
                            <td>@item.EndTime</td>

                            <td>@item.User?.FullName</td>

                            <td>
                                <span class="badge bg-success">Aktif</span>
                            </td>

                            <td>
                                <a href="/Reservation/Edit/@item.ReservationId" class="btn btn-edit btn-sm">
                                    Düzenle
                                </a>

                                <a href="/Reservation/Cancel/@item.ReservationId" class="btn btn-secondary btn-sm">
                                    İptal
                                </a>

                        @if (User.IsInRole("Admin"))
                        {
                                        <a href="/Reservation/Delete/@item.ReservationId" class="btn btn-danger btn-sm">
                                            Sil
                                        </a>
                        }
                            </td>
                        </tr>
            }
        }
    </tbody>
</table>

<a href="/Reservation/Create" class="btn btn-reserve mt-3">
    Yeni Rezervasyon Ekle
</a>
